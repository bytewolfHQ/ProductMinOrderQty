<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="ByteWolfHQ\ProductMinOrderQty\Subscriber\ProductPageSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="ByteWolfHQ\ProductMinOrderQty\Validator\MinOrderQtyCartValidator">
            <tag name="shopware.cart.validator"/>
        </service>

        <service id="ByteWolfHQ\ProductMinOrderQty\Order\ValidatingOrderPersister"
                 decorates="Shopware\Core\Checkout\Cart\Order\OrderPersister">
            <argument type="service" id="ByteWolfHQ\ProductMinOrderQty\Order\ValidatingOrderPersister.inner"/>
            <argument type="service" id="product.repository"/>
        </service>

    </services>

</container>